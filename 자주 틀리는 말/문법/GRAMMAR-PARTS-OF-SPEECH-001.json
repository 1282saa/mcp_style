      "structure": {
        "rule_path": ["작성원칙", "문법규칙", "품사구분"],
        "hint": "품사 구분이 명확해야 문장이 정확하게 전달됩니다.",
        "tags": ["문법", "품사", "의존명사", "조사", "어미"],
        "rule_applicability": ["기사 작성", "편집"],
        "classification": ["문법 규칙", "어휘 선택"],
        "keywords": [
          "품사",
          "의존명사",
          "조사",
          "어미",
          "연결어미",
          "접두사",
          "관형사"
        ],
        "guideline": {
          "guideline_id": "GRAMMAR-PARTS-OF-SPEECH-001",
          "category": "품사 구분",
          "note": "쓰이는 경우에 따라 품사와 뜻이 달라지는 단어",
          "examples": [
            {
              "word": "데",
              "usages": [
                {
                  "type": "의존명사",
                  "meaning": "'곳', '장소', '일', '것', '경우'의 뜻",
                  "example": "포스코 역시 2,000억원 증가하는 데 그쳤다."
                },
                {
                  "type": "연결어미",
                  "meaning": "뒷절에서 어떤 일을 설명하거나 묻거나 시키거나 제안하기 위해 상관되는 상황을 미리 말할 때 사용",
                  "example": "리니지Ⅱ는 지난 1월 공개시범 서비스를 시작했는데 현재 7만 7,000명의 최고동시접속자 수를 기록하고 있다."
                }
              ]
            },
            {
              "word": "만",
              "usages": [
                {
                  "type": "의존명사",
                  "meaning": "'얼마간 계속되었음', '타당한 이유가 있음', '가능함'을 나타냄",
                  "example": "국제유가가 다시 올라 1주일 만에 배럴당 42달러에 달했다."
                },
                {
                  "type": "조사",
                  "meaning": "한정이나 강조, 정도에 달함을 나타냄",
                  "example": "월 1,500원만 추가로 내면 가족간 통화를 무료로 이용할 수 있다."
                },
                {
                  "type": "접미사",
                  "meaning": "어떤 정도에 미침을 뜻함",
                  "example": "주먹만한 우박, 그 영화는 볼 만하다."
                }
              ]
            },
            {
              "word": "지",
              "usages": [
                {
                  "type": "의존명사",
                  "meaning": "어떤 일이 있었던 때로부터 지금까지의 동안",
                  "example": "조 사장이 취임한 지 1년이 지났다."
                },
                {
                  "type": "어미",
                  "meaning": "추측에 대한 막연한 의문이 있는 채로 뒷절과 관련시킴",
                  "example": "검찰은 박 의원이 3억원을 받았는지 여부를 조사할 계획이다."
                }
              ]
            },
            {
              "word": "대로",
              "usages": [
                {
                  "type": "조사",
                  "meaning": "앞에 오는 말에 근거하거나 달라짐이 없음, 따로따로 구별됨",
                  "example": "법대로 해라."
                },
                {
                  "type": "의존명사",
                  "meaning": "'어떤 모양이나 상태와 같이', '어떤 상태나 행동이 나타나는 그 즉시 혹은 족족'",
                  "example": "이 상품은 고객이 원하는 대로 설계해준다."
                },
                {
                  "type": "부사",
                  "note": "'되는대로'는 한 단어로 인정"
                }
              ]
            },
            {
              "word": "뿐",
              "usages": [
                {
                  "type": "조사",
                  "meaning": "체언 밑에 붙어 그것만을 나타냄"
                },
                {
                  "type": "의존명사",
                  "meaning": "용언 밑에 붙어 어찌할 따름이라는 뜻",
                  "example": "네가 가라고 해서 갔을 뿐이다. 즐거울 뿐이다."
                }
              ]
            },
            {
              "word": "한",
              "usages": [
                {
                  "type": "접두사",
                  "meaning": "'큰', '정확한' 또는 '같은'의 뜻",
                  "example": "한걱정, 한길, 한시름, 한가운데, 한겨울, 한낮, 한복판, 한잠, 한패, 한마을, 한집안"
                },
                {
                  "type": "의존명사",
                  "meaning": "조건의 뜻으로 주로 '-는 한'으로 쓰임",
                  "example": "힘이 닿는 한 도와야지."
                },
                {
                  "type": "관형사",
                  "meaning": "'수량이 하나'이거나 '어떤', '대략'의 뜻",
                  "example": "한 줄, 한 고위관리, 한 20분쯤"
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
