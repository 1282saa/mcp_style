        "hint": "영어를 직역한 표현은 한국어 문장에서 어색할 수 있습니다.",
        "tags": ["문법", "표현", "영어식", "직역"],
        "rule_applicability": ["기사 작성", "편집"],
        "classification": ["문법 규칙", "표현"],
        "keywords": [
          "영어식",
          "서술",
          "직역",
          "전치사",
          "의하여",
          "으로부터",
          "필요로하다",
          "요구된다"
        ],
        "guideline": {
          "guideline_id": "GRAMMAR-ENGLISH-EXPRESSIONS-017",
          "category": "영어식 서술 지양",
          "note": "영어 전치사와 표현을 직역한 표현은 한국어 문장에서 어색합니다.",
          "explanation": "영어의 전치사와 표현 구조를 그대로 옮긴 번역투는 자연스러운 한국어 표현으로 대체해야 합니다.",
          "examples": [
            {
              "type": "~에 의하여",
              "note": "'by'를 과도하게 번역한 것",
              "examples": [
                {
                  "before": "개정된 헌법을 이제 국회의 의결을 거쳐 국민투표에 의하여 개정한다.",
                  "after": "개정된 헌법을 이제 국회의 의결을 거쳐 국민투표로 개정한다."
                },
                {
                  "before": "어민들의 직선에 의하여 뽑힌 대표",
                  "after": "어민들이 직선으로 뽑은 대표"
                }
              ]
            },
            {
              "type": "~으로부터",
              "note": "'from'(출처, 기원, 근원, 유래를 나타내는 전치사)",
              "examples": [
                {
                  "before": "적으로부터 공격을 받았다.",
                  "after": "적의 공격을 받았다."
                },
                {
                  "before": "대통령이 김 대표로부터 당무 보고를 받았다.",
                  "after": "대통령이 김 대표의(김 대표에게) 당무 보고를 받았다."
                },
                {
                  "before": "부산행 열차는 서울역으로부터 출발한다.",
                  "after": "부산행 열차는 서울역에서 출발한다."
                },
                {
                  "before": "친구로부터 돈을 빌렸다.",
                  "after": "친구에게(친구한테서) 돈을 빌렸다."
                },
                {
                  "before": "어떤 외부간섭으로부터도 보호돼야 한다.",
                  "after": "어떤 외부간섭도 배제해야 한다."
                }
              ]
            },
            {
              "type": "~을 필요로 하다",
              "note": "'need' 또는 'require'를 직역한 표현",
              "examples": [
                {
                  "before": "한 사람이 필요로 하는 분량이 얼마나 됩니까.",
                  "after": "한 사람에게 필요한 분량이 얼마나 됩니까."
                },
                {
                  "before": "설명을 필요로 하지 않는다.",
                  "after": "설명이 필요 없다. 설명이 필요하지 않다."
                }
              ]
            },
            {
              "type": "~이 요구된다",
              "note": "'require'를 직역",
              "examples": [
                {
                  "before": "나는 내게 요구되는 일은 모두 하겠다.",
                  "after": "내게 요구하는 일은 모두 하겠다, 내가 할 일은 다 하겠다."
                }
              ]
            }
          ]
        }
      }
    }
  ]
}
