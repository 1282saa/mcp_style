                "after": "홍수로 인한 황폐화"
              },
              {
                "before": "쭈꾸미",
                "after": "주꾸미"
              }
            ]
          },
          {
            "guideline_id": "CONFUSING-EXPRESSIONS-SIMILAR-MEANINGS-010",
            "category": "의미 혼동하기 쉬운 표현들",
